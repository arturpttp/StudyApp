{
  "openapi": "3.1.0",
  "info": {
    "title": "HealthQuest API",
    "version": "1.0.0",
    "description": "API para plataforma de estudos em saúde"
  },
  "servers": [
    {
      "url": "http://localhost:3000"
    }
  ],
  "components": {
    "schemas": {
      "Subject": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "Institution": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "Alternative": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "position": {
            "type": "integer"
          }
        },
        "required": [
          "id",
          "text",
          "position"
        ]
      },
      "Topic": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "Flashcard": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "front": {
            "type": "string"
          },
          "back": {
            "type": "string"
          },
          "easeFactor": {
            "type": "number"
          },
          "interval": {
            "type": "integer"
          },
          "repetitions": {
            "type": "integer"
          },
          "lastReview": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "nextReview": {
            "type": "string",
            "format": "date-time"
          },
          "questionId": {
            "type": [
              "string",
              "null"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "topics": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Topic"
            }
          }
        },
        "required": [
          "id",
          "front",
          "back",
          "easeFactor",
          "interval",
          "repetitions",
          "lastReview",
          "nextReview",
          "questionId",
          "createdAt",
          "topics"
        ]
      },
      "Question": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "statement": {
            "type": "string"
          },
          "difficulty": {
            "type": "string",
            "enum": [
              "EASY",
              "MEDIUM",
              "HARD"
            ]
          },
          "year": {
            "type": [
              "integer",
              "null"
            ]
          },
          "subject": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Subject"
              },
              {
                "type": [
                  "object",
                  "null"
                ]
              }
            ]
          },
          "institution": {
            "$ref": "#/components/schemas/Institution"
          },
          "alternatives": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Alternative"
            }
          },
          "topics": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Topic"
            }
          }
        },
        "required": [
          "id",
          "statement",
          "difficulty",
          "year",
          "subject",
          "institution",
          "alternatives",
          "topics"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "fields": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "required": [
          "error"
        ]
      },
      "ExamAlternative": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "position": {
            "type": "integer"
          }
        },
        "required": [
          "id",
          "text",
          "position"
        ]
      },
      "ExamQuestionActive": {
        "type": "object",
        "properties": {
          "questionId": {
            "type": "string"
          },
          "order": {
            "type": "integer"
          },
          "statement": {
            "type": "string"
          },
          "alternatives": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ExamAlternative"
            }
          },
          "selectedAlternativeId": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "questionId",
          "order",
          "statement",
          "alternatives",
          "selectedAlternativeId"
        ]
      },
      "ExamQuestionReport": {
        "type": "object",
        "properties": {
          "questionId": {
            "type": "string"
          },
          "order": {
            "type": "integer"
          },
          "statement": {
            "type": "string"
          },
          "explanation": {
            "type": [
              "string",
              "null"
            ]
          },
          "alternatives": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ExamAlternative"
            }
          },
          "selectedAlternativeId": {
            "type": [
              "string",
              "null"
            ]
          },
          "correctAlternativeId": {
            "type": "string"
          },
          "isCorrect": {
            "type": "boolean"
          }
        },
        "required": [
          "questionId",
          "order",
          "statement",
          "explanation",
          "alternatives",
          "selectedAlternativeId",
          "correctAlternativeId",
          "isCorrect"
        ]
      },
      "ExamInProgress": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "IN_PROGRESS"
            ]
          },
          "timeLimit": {
            "type": [
              "integer",
              "null"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "questions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ExamQuestionActive"
            }
          }
        },
        "required": [
          "id",
          "status",
          "timeLimit",
          "createdAt",
          "questions"
        ]
      },
      "ExamFinished": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "FINISHED"
            ]
          },
          "score": {
            "type": "number"
          },
          "timeLimit": {
            "type": [
              "integer",
              "null"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "finishedAt": {
            "type": "string",
            "format": "date-time"
          },
          "questions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ExamQuestionReport"
            }
          }
        },
        "required": [
          "id",
          "status",
          "score",
          "timeLimit",
          "createdAt",
          "finishedAt",
          "questions"
        ]
      },
      "StatsOverview": {
        "type": "object",
        "properties": {
          "totalAnswered": {
            "type": "integer"
          },
          "totalCorrect": {
            "type": "integer"
          },
          "accuracyAll": {
            "type": "integer"
          },
          "totalAnsweredWeek": {
            "type": "integer"
          },
          "accuracyWeek": {
            "type": "integer"
          },
          "currentStreak": {
            "type": "integer"
          }
        },
        "required": [
          "totalAnswered",
          "totalCorrect",
          "accuracyAll",
          "totalAnsweredWeek",
          "accuracyWeek",
          "currentStreak"
        ]
      },
      "StatsTopicEntry": {
        "type": "object",
        "properties": {
          "topicId": {
            "type": "string"
          },
          "topicName": {
            "type": "string"
          },
          "answered": {
            "type": "integer"
          },
          "correct": {
            "type": "integer"
          },
          "accuracy": {
            "type": "integer"
          }
        },
        "required": [
          "topicId",
          "topicName",
          "answered",
          "correct",
          "accuracy"
        ]
      },
      "StatsExams": {
        "type": "object",
        "properties": {
          "totalFinished": {
            "type": "integer"
          },
          "avgScore": {
            "type": "integer"
          },
          "bestScore": {
            "type": "integer"
          },
          "scores": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "examId": {
                  "type": "string"
                },
                "date": {
                  "type": "string",
                  "format": "date-time"
                },
                "score": {
                  "type": "integer"
                }
              },
              "required": [
                "examId",
                "date",
                "score"
              ]
            }
          }
        },
        "required": [
          "totalFinished",
          "avgScore",
          "bestScore",
          "scores"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/api/v1/subjects": {
      "get": {
        "summary": "Listar especialidades",
        "responses": {
          "200": {
            "description": "Lista de especialidades",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Subject"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Não autenticado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/topics": {
      "get": {
        "summary": "Listar matérias",
        "responses": {
          "200": {
            "description": "Lista de matérias",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Topic"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Não autenticado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/institutions": {
      "get": {
        "summary": "Listar instituições",
        "responses": {
          "200": {
            "description": "Lista de instituições",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Institution"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Não autenticado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/questions": {
      "get": {
        "summary": "Listar questões com filtros",
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            },
            "required": false,
            "name": "page",
            "in": "query"
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            },
            "required": false,
            "name": "limit",
            "in": "query"
          },
          {
            "schema": {
              "type": "string"
            },
            "required": false,
            "name": "subjectId",
            "in": "query"
          },
          {
            "schema": {
              "type": "string"
            },
            "required": false,
            "name": "institutionId",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "EASY",
                "MEDIUM",
                "HARD"
              ]
            },
            "required": false,
            "name": "difficulty",
            "in": "query"
          },
          {
            "schema": {
              "type": [
                "integer",
                "null"
              ]
            },
            "required": false,
            "name": "year",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "true",
                "false"
              ]
            },
            "required": false,
            "name": "unanswered",
            "in": "query"
          },
          {
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "required": false,
            "name": "topicIds",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "any",
                "all"
              ]
            },
            "required": false,
            "name": "topicMatchMode",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Lista paginada de questões",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Question"
                      }
                    },
                    "total": {
                      "type": "integer"
                    },
                    "page": {
                      "type": "integer"
                    },
                    "limit": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "data",
                    "total",
                    "page",
                    "limit"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Parâmetros inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Não autenticado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/questions/random": {
      "get": {
        "summary": "Questão aleatória",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "enum": [
                "EASY",
                "MEDIUM",
                "HARD"
              ]
            },
            "required": false,
            "name": "difficulty",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Uma questão aleatória",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Question"
                }
              }
            }
          },
          "404": {
            "description": "Nenhuma questão encontrada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/questions/{id}": {
      "get": {
        "summary": "Detalhe da questão",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Detalhe da questão (sem isCorrect)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Question"
                }
              }
            }
          },
          "404": {
            "description": "Questão não encontrada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/questions/{id}/answer": {
      "post": {
        "summary": "Enviar resposta",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "alternativeId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "responseTime": {
                    "type": "integer",
                    "minimum": 0,
                    "default": 0
                  }
                },
                "required": [
                  "alternativeId"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Resultado da resposta",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "isCorrect": {
                      "type": "boolean"
                    },
                    "correctAlternativeId": {
                      "type": "string"
                    },
                    "explanation": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "isCorrect",
                    "correctAlternativeId",
                    "explanation"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Dados inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Questão não encontrada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/exams/generate": {
      "post": {
        "summary": "Gerar simulado",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "subjectId": {
                    "type": "string"
                  },
                  "difficulty": {
                    "type": "string",
                    "enum": [
                      "EASY",
                      "MEDIUM",
                      "HARD"
                    ]
                  },
                  "count": {
                    "type": "integer",
                    "minimum": 5,
                    "maximum": 100
                  },
                  "timeLimit": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 5,
                    "maximum": 600
                  },
                  "topicIds": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "topicMatchMode": {
                    "type": "string",
                    "enum": [
                      "any",
                      "all"
                    ]
                  }
                },
                "required": [
                  "count"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Simulado criado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "id"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Dados inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Pool insuficiente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/exams/{id}": {
      "get": {
        "summary": "Buscar simulado (ativo ou finalizado)",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Estado do simulado",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/ExamInProgress"
                    },
                    {
                      "$ref": "#/components/schemas/ExamFinished"
                    }
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Simulado não encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/exams/{id}/questions/{questionId}": {
      "patch": {
        "summary": "Atualizar seleção de alternativa",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "id",
            "in": "path"
          },
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "questionId",
            "in": "path"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "alternativeId": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "minLength": 1
                  }
                },
                "required": [
                  "alternativeId"
                ]
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Seleção salva"
          },
          "400": {
            "description": "Dados inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Não encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Simulado já finalizado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/exams/{id}/finish": {
      "patch": {
        "summary": "Finalizar simulado",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Relatório final",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExamFinished"
                }
              }
            }
          },
          "404": {
            "description": "Simulado não encontrado",
            "content": {
              "application/json": {
                "schema": {
